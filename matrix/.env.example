# Домен, на котором будет жить мессенджер (A/AAAA-запись должна указывать на ваш Mac)
MATRIX_DOMAIN=chat.example.com

# E-mail для Let's Encrypt (уведомления об истечении сертификата)
ACME_EMAIL=admin@example.com

# Пароль к PostgreSQL (любая длинная случайная строка)
POSTGRES_PASSWORD=change-me-postgres

# Секрет для создания пользователей без открытой регистрации (любая длинная случайная строка)
REGISTRATION_SHARED_SECRET=change-me-registration-secret

# Ваш главный аккаунт (видит все проекты)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password
